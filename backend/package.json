{
  "name": "chimedis-api",
  "version": "1.0.0",
  "description": "Chimedis API - Google Sheets to JSON API server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node sync-frontend.js && node build-api.js",
    "build:watch": "node --watch build-api.js",
    "import:herbs": "node import-herbal-sheets.js",
    "import:anatomy": "node import-anatomy-terms.js",
    "mt-review:export": "node export-mt-review-sheet.js",
    "mt-review:import": "node import-mt-review-sheet.js"
  },
  "keywords": [
    "chimedis",
    "api",
    "google-sheets",
    "tcm"
  ],
  "author": "Hạ Vân Minh",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^120.0.0",
    "mysql2": "^3.23.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
