# Chimedis API Configuration

# Server
PORT=3000
NODE_ENV=production

# Google Sheets
# Get SHEET_ID from: https://docs.google.com/spreadsheets/d/[SHEET_ID]/...
GOOGLE_SHEETS_ID=1wXldDsL7Zs3GYEXx7o1n3y7T1KHiWkasAgWNhBIUHaI

# Google Cloud Credentials
# Download from Google Cloud Console > Service Accounts > Create Key > JSON
# Store full JSON as single line or paste as file path
GOOGLE_CREDENTIALS_JSON=/path/to/credentials.json

# Webhook security
WEBHOOK_SECRET=your-secret-key-here

# Firebase Admin (đăng nhập người dùng — backend xác thực ID token do frontend gửi lên)
# Lấy tại: Firebase Console > Project settings > Service accounts > Generate new private key
# Encode file JSON đó sang base64 1 dòng (giống GOOGLE_CREDENTIALS_JSON_B64) rồi dán vào đây.
FIREBASE_ADMIN_CREDENTIALS_JSON_B64=

# API
API_URL=https://chimedis-api.example.com

# Cloudflare (for PWA)
CLOUDFLARE_API_TOKEN=your-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Hostinger
HOSTINGER_HOST=your-hostinger-host
HOSTINGER_USERNAME=your-username
HOSTINGER_PASSWORD=your-password
