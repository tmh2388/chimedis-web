# Sao chép sang .github/workflows/claude-todo.yml khi đã đặt secret ANTHROPIC_API_KEY.
name: claude-todo
on:
  issues:
    types: [labeled]
permissions:
  contents: write
  pull-requests: write
  issues: write
jobs:
  fix:
    if: github.event.label.name == 'claude-todo'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          prompt: |
            Đọc Issue #${{ github.event.issue.number }} (ghi chú của admin Chimedis). Sửa đúng phần được yêu cầu,
            giữ nguyên các phần đang ổn, kiểm tra cú pháp, tăng phiên bản service worker, rồi mở Pull Request
            liên kết Issue. Không tự merge.
